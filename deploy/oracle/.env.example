# deploy.sh 首次部署自动生成随机管理员密码；已有配置不会被覆盖。
# 镜像由部署脚本按 Git 提交号选择，不需要填写 GHCR 地址。
# 如需手动使用预构建镜像，可另设 ICLOUD_HME_IMAGE。

# 必填：独立随机密码，至少 8 字符。
# 含 $ 或 # 的值使用单引号包裹，避免 .env 插值或注释解析。
ICLOUD_HME_ADMIN_PASSWORD=

ICLOUD_HME_BIND_PORT=8081
ICLOUD_HME_SESSION_TTL=12h
# HTTP 经 SSH 隧道访问时保持 false；通过 HTTPS 反向代理访问时设为 true。
ICLOUD_HME_SECURE_COOKIE=false
